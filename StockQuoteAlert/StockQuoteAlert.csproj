<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>stock-quote-alert</AssemblyName>
    <RootNamespace>StockQuoteAlert</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the test project call internal members (MonitorServices.CheckOnceAsync, ApiConnect test constructor). -->
    <InternalsVisibleTo Include="StockQuoteAlert.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>